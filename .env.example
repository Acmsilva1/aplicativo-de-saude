NODE_ENV=production
PORT=5199
# Em HTTPS (VM/nginx) use true
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

# URL pública do app (links de convite/recuperação de senha)
APP_PUBLIC_URL=https://controle-de-saude.duckdns.org

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Bootstrap one-shot: npm run bootstrap:admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Fallback de e-mail quando o SMTP do Supabase falha (gera link + envia via app).
# Preferência: Gmail SMTP (App Password). Sem domínio próprio, Resend onboarding@resend.dev
# NÃO entrega para terceiros — use Gmail ou domínio verificado no Resend.
#
# Gmail: Conta Google → Segurança → Verificação em 2 etapas → Senhas de app → gerar.
# Use a senha de 16 caracteres em SMTP_PASS (não a senha normal da conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional: se SMTP falhar ou não estiver configurado, tenta Resend.
# RESEND_API_KEY=
# RESEND_FROM=Ritmo Saúde <onboarding@resend.dev>

# Opcional: rate limit de login compartilhado (Upstash Redis REST).
# Sem isso, o app usa contador em memória no processo.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
